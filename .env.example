# Copy this file to .env (gitignored) and fill in real values. Everything here can
# also be edited from Settings in the app.

# The language of the app: en (English, the default) or es (Spanish).
# APP_LANGUAGE=en

# Where backup-data.sh writes the backups (calendar, profile, messages, CV, photo, this file)
# and restore-backup.sh reads them from.
BACKUP_DIR=backup

# Database local storage
CAREER_MODE_DB=data/career-mode.db

# Optional, and read when the server starts.
PORT=8333

# Used by scripts/generate_daily_image.py (see .claude/skills/write-daily-post/SKILL.md)
# to generate an image via the Gemini API.
GEMINI_API_KEY=your-gemini-api-key

# The address the application emails are sent from and its password (for Gmail, an
# app password: Google account, Security, 2-Step Verification, App passwords). The
# skills send through the app, with no browser. Gmail's server is the default; for
# another provider set its SMTP server and port (465 or 587).
# EMAIL_ADDRESS=you@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465

# Read by the Google Calendar button of the Calendar (Sync Google Calendar): the ID of your
# Google Calendar, or its secret iCal address. Leave it out and the button stays off.
# GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Your CV as a PDF of up to 1 MB on this computer (/setup copies it to
# profile/cv.pdf): the skills attach and upload this file.
# CV_PDF_PATH=profile/cv.pdf
